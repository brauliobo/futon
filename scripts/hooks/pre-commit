#!/usr/bin/env bash
# Pedagogy guard: runs before every commit to ensure content + rubric
# edits don't silently regress. Install via `pnpm hooks:install`.

set -e

# Only run if any YAML under src/levels, any pedagogy script, or any
# scripts/lib file is staged — otherwise this is a no-op and fast.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
if ! echo "$STAGED" | grep -qE '^(src/levels/|scripts/(pedagogy-eval|fix-|find-|test-|lib/)|src/utils/Shuffle)'; then
  exit 0
fi

echo "→ pedagogy guard: running test:eval + snapshot + topic + intra-page + cross-set"
pnpm -s test:eval
pnpm -s eval:snapshot --threshold -3 || {
  echo ""
  echo "❌ pedagogy regression detected. Review above or update the baseline"
  echo "   intentionally with: pnpm eval:snapshot --save"
  exit 1
}
# Topic-consistency catches bucketed-rationale misroutings that the rubric
# can't see (rationale mentions "sec²" but exercise is about sin/cos, etc.).
# Cheap check — runs on the whole corpus in well under a second.
pnpm -s eval:topic || {
  echo ""
  echo "❌ topic-consistency: a rationale mentions a domain marker but its"
  echo "   exercise isn't on that topic. Fix the rationale or update rules"
  echo "   in scripts/eval-topic-consistency.js."
  exit 1
}
# Intra-page and cross-set conflict guards — catch ambiguous duplicates
# where the same question has different expected answers.
pnpm -s eval:intra-page || {
  echo ""
  echo "❌ intra-page: two exercises with the same question text have"
  echo "   different expected answers on the same page. Disambiguate the"
  echo "   question (see scripts/fix-{quadratic-root,factoring,mesma-situacao}.js)."
  exit 1
}
pnpm -s eval:cross-set || {
  echo ""
  echo "❌ cross-set: the same question appears in multiple sets of the"
  echo "   same level with different expected answers (non-synonym)."
  echo "   Disambiguate with a clarifier or standardize the answer."
  exit 1
}
# Zero-state tripwires promoted to hard-fail (iter 187): these three
# detectors reported 0 hits across the corpus and are now gated at
# commit time to prevent regression.
pnpm -s eval:tautological || {
  echo ""
  echo "❌ tautological-rationale re-introduced. See PEDAGOGY.md"
  echo "   \"Manual rewrite guide\" for the 4 rewrite strategies."
  exit 1
}
pnpm -s eval:pt-category || {
  echo ""
  echo "❌ PT category-mismatch: a rationale names a grammar category"
  echo "   that doesn't match the correctAnswer's category. Rewrite"
  echo "   to describe the answer's actual category."
  exit 1
}
pnpm -s eval:example-spoiler || {
  echo ""
  echo "❌ example-spoiler: set-level example duplicates exercise #1."
  echo "   Run pnpm fix:example-spoiler --apply, or pick a different"
  echo "   donor instance manually."
  exit 1
}
pnpm -s eval:pt-pluralization || {
  echo ""
  echo "❌ PT pluralization: English-style -s plural on a Portuguese"
  echo "   -ção/-al/-el/-il noun. Use the proper plural:"
  echo "   animal→animais, lição→lições, coração→corações, fácil→fáceis."
  exit 1
}
pnpm -s eval:meta-question || {
  echo ""
  echo "❌ meta-question: template-shell question with no teaching content."
  echo "   Rewrite with a real prompt about the set's topic (see PT D/11-20)."
  exit 1
}
