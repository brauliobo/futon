    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.21",
    "cli-table3": "^0.6.5",
    "fast-glob": "^3.3.2",
    "postcss": "^8.5.6",
    "pug": "^3.0.3",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.1",
    "vite-plugin-pwa": "^1.2.0",
    "yaml": "^2.8.1"
  }
