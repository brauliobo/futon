    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.21",
    "cli-table3": "^0.6.5",
    "fast-glob": "^3.3.2",
    "mathjs": "^15.2.0",
    "postcss": "^8.5.6",
