{
  "name": "futon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp docs/index.html docs/404.html",
    "preview": "vite preview",
    "validate:levels": "node ./scripts/validate-lessons.mjs",
    "validate:sets": "node ./validate-sets.js",
    "targets:set": "node ./scripts/set-targets.mjs",
    "targets:refresh": "pnpm run targets:set && pnpm run validate:levels",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@executeautomation/playwright-mcp-server": "^1.0.6",
    "bootstrap": "^5.3.3",
    "lucide-vue-next": "^0.544.0",
    "vue": "^3.4.37",
    "vue-i18n": "^10.0.0",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@rollup/plugin-yaml": "^4.1.2",
    "@vitejs/plugin-vue": "^5.1.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.21",
    "cli-table3": "^0.6.5",
    "fast-glob": "^3.3.2",
    "postcss": "^8.5.6",
    "pug": "^3.0.3",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.1",
    "yaml": "^2.8.1"
  }
}
