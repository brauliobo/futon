    "audit:content": "node ./scripts/audit-content.js",
    "eval:pedagogy": "node ./scripts/pedagogy-eval.js",
    "eval:rationales": "node ./scripts/rationale-review.js",
    "eval:disconnected": "node ./scripts/find-disconnected.js",
    "eval:bias": "node ./scripts/find-answer-bias.js",
    "eval:time": "node ./scripts/eval-time-budget.js",
    "eval:duplicates": "node ./scripts/eval-duplicates.js",
    "eval:review": "node ./scripts/eval-manual-review.js",
    "eval:arithmetic": "node ./scripts/eval-arithmetic.js",
    "eval:alignment": "node ./scripts/eval-example-alignment.js",
    "eval:relevance": "node ./scripts/eval-rationale-relevance.js",
    "eval:coverage": "node ./scripts/eval-coverage.js",
    "eval:diversity": "node ./scripts/eval-rationale-diversity.js",
    "eval:answers": "node ./scripts/eval-answer-in-choices.js",
    "eval:topic": "node ./scripts/eval-topic-consistency.js",
    "eval:intra-page": "node ./scripts/eval-intra-page-dupes.js",
    "eval:cross-set": "node ./scripts/eval-cross-set-conflicts.js",
    "eval:orphan-objectives": "node ./scripts/eval-orphan-objectives.js",
    "eval:dup-titles": "node ./scripts/eval-duplicate-titles.js",
    "eval:input-type": "node ./scripts/eval-input-type.js",
