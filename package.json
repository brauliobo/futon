    "fix:restatements": "node ./scripts/fix-restatements.js",
    "fix:binomial:rationales": "node ./scripts/fix-binomial-rationales.js",
    "fix:5a:rationales": "node ./scripts/fix-5a-rationales.js",
    "fix:5a:counting": "node ./scripts/fix-5a-counting-rationales.js",
    "fix:6a:counting": "node ./scripts/fix-6a-counting-rationales.js",
    "fix:integral:rationales": "node ./scripts/fix-integral-rationales.js",
    "fix:power:root": "node ./scripts/fix-power-root-rationales.js",
    "fix:series:rationales": "node ./scripts/fix-series-rationales.js",
    "fix:pass-criteria": "node ./scripts/fix-pass-criteria.js",
    "eval:snapshot": "node ./scripts/pedagogy-snapshot.js",
    "eval:dashboard": "node ./scripts/pedagogy-dashboard.js",
