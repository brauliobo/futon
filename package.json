    "scaffold": "node ./scripts/scaffold-set.mjs",
    "migrate:types": "node ./scripts/migrate-exercise-types.mjs",
    "targets:set": "node ./scripts/set-targets.mjs",
    "targets:refresh": "pnpm run targets:set && pnpm run validate:sets",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report"
