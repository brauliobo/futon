{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://futon.local/schemas/level.math.schema.json",
  "title": "Level",
  "type": "object",
  "required": ["title", "level", "subject", "pages"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "level": { "type": "string", "minLength": 1 },
    "example": { "type": "string" },
    "subject": { "type": "string", "enum": ["math", "portuguese", "english"] },
    "target": { "type": "integer", "minimum": 1 },
    "repeatAll": { "type": "integer", "minimum": 1 },
    "passCriteria": {
      "type": "object",
      "properties": {
        "minAccuracyPercent": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxAvgSecondsPerExercise": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pageNumber", "title", "description", "exercises"],
        "properties": {
          "pageNumber": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "exercises": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type", "question", "correctAnswer"],
              "properties": {
                "type": { "type": "string", "enum": [
                  "addition",
                  "subtraction",
                  "multiplication",
                  "division",
                  "count",
                  "next_number",
                  "previous_number",
                  "fraction_add",
                  "fraction_sub",
                  "fraction_mixed",
                  "reading",
                  "grammar",
                  "english_vocab",
                  "english_phrases"
                ] },
                "question": { "type": "string", "minLength": 1 },
                "correctAnswer": { "oneOf": [ { "type": "number" }, { "type": "string", "minLength": 1 } ] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

